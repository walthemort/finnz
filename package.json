{
  "name": "finnz-trae-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
    "preview": "node --use-env-proxy node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "start": "node --use-env-proxy --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "vite": "7.3.1"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/manrope": "5.2.8"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
